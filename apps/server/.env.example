# 模型
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# 可选：默认 deepseek-flash
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# QQ 机器人（q.qq.com → 开发设置）
QQBOT_APPID=你的AppID
QQBOT_SECRET=你的AppSecret

# 可选：服务端口
# PORT=3000

# 可选：历史与记忆
# HISTORY_STORE=200
# HISTORY_SEND=40
# HISTORY_SUMMARIZE_AT=150
# HISTORY_KEEP_AFTER=20

# 可选：消息聚合（连发多条/多图合成一轮）
# BATCH_SILENCE_MS=2500
# BATCH_MAX_TEXTS=10
# BATCH_MAX_IMAGES=6

# 可选：主动消息
# PROACTIVE_ENABLED=true
# PROACTIVE_INTERVAL_MS=2700000
# PROACTIVE_QUIET_START=23
# PROACTIVE_QUIET_END=9
# PROACTIVE_MIN_IDLE_MS=10800000
