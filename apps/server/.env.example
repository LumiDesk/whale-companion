# 命令行模式使用；桌面版在设置页填写，不走这个文件。
# 也可以把它放到 WhaleCompanion\server\.env，再在设置页点「从 .env 导入」。

# 必填：模型
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# 可选：默认 deepseek-flash；桌面端可以点「获取模型」拉列表
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# 思考强度：off / low / high / max（默认 high；off 时 temperature 才生效）
# DEEPSEEK_THINKING_EFFORT=high
# 温度：留空跟随服务商默认；思考开启时不生效
# DEEPSEEK_TEMPERATURE=
# 最大输出 token，0 表示不限制
# DEEPSEEK_MAX_TOKENS=0
# 单次请求超时（毫秒）与失败重试次数
# DEEPSEEK_TIMEOUT_MS=45000
# DEEPSEEK_RETRIES=1
# 额外请求参数（JSON 对象；不能覆盖 model/messages/stream/thinking）
# DEEPSEEK_EXTRA_BODY={}

# 必填：QQ 机器人（q.qq.com → 开发设置）
QQBOT_APPID=你的AppID
QQBOT_SECRET=你的AppSecret

# 可选：看图与图片预算
# VISION_ENABLED=true
# LLM_MAX_IMAGES=6
# LLM_MAX_IMAGE_BYTES=16777216

# 可选：历史与记忆
# HISTORY_STORE=200
# HISTORY_SEND=40
# HISTORY_SUMMARIZE_AT=150
# HISTORY_KEEP_AFTER=20
# REPLY_MAX_CHARS=500

# 可选：称呼（人设与提示词里的「主人」会替换成它）
# OWNER_NAME=主人

# 可选：消息聚合（停口多久回复 / 一轮最多等多久）
# BATCH_SILENCE_MS=3000
# BATCH_MAX_WAIT_MS=10000
# BATCH_MAX_TEXTS=10
# BATCH_MAX_IMAGES=6

# 可选：Agent 回合（不配置就使用默认值）
# AGENT_ENABLED=true
# 风格：standard / restrained / chatty
# AGENT_STYLE=standard
# AGENT_MAX_STEPS=6
# AGENT_MAX_MESSAGES=3
# AGENT_REPLY_DELAY_MS=800
# AGENT_GAP_MIN_MS=800
# AGENT_GAP_MAX_MS=2500
# AGENT_WAIT_MAX_MS=20000
# AGENT_SILENCE_ENABLED=true
# AGENT_MAX_SILENT_STREAK=3
# AGENT_TURN_TIMEOUT_MS=120000

# 可选：单张图片上限（字节）
# MEDIA_MAX_BYTES=8388608

# 可选：联网搜索（DeepSeek 官方 Search / Fetch，按成功请求计费）
# WEB_SEARCH_ENABLED=true
# WEB_SEARCH_MAX_RESULTS=5
# WEB_SEARCH_TIMEOUT_MS=15000
# WEB_FETCH_MAX_CHARS=6000

# 可选：表情包
# STICKER_ENABLED=true
# STICKER_CHANCE=0.05
# STICKER_COOLDOWN_MS=480000
# STICKER_MIN_SCORE=0.12
# STICKER_ALLOW_RANDOM=true
# STICKER_AUTO_INGEST=true
# STICKER_TAG_CONCURRENCY=2
# STICKER_MAX_LIBRARY=0

# 可选：主动消息
# PROACTIVE_ENABLED=true
# PROACTIVE_INTERVAL_MS=2700000
# PROACTIVE_QUIET_START=23
# PROACTIVE_QUIET_END=9
# PROACTIVE_MIN_IDLE_MS=10800000
# PROACTIVE_MAX_IDLE_DAYS=7
# PROACTIVE_MAX_PER_DAY=1

# 可选：日志级别
# LOG_LEVEL=info
