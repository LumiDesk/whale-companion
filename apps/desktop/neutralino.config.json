{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "com.talyra42.whale-companion",
  "version": "1.0.1",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": true,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "app.*",
    "os.*",
    "window.*",
    "filesystem.*",
    "debug.*"
  ],
  "modes": {
    "window": {
      "title": "小鲸鱼",
      "width": 940,
      "height": 720,
      "minWidth": 780,
      "minHeight": 600,
      "center": true,
      "icon": "/resources/icons/app.png",
      "enableInspector": false,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": false,
      "injectGlobals": true
    }
  },
  "cli": {
    "binaryName": "whale-companion",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.10.0",
    "clientVersion": "6.10.0"
  }
}
