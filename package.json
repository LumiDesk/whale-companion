{
  "name": "whale-companion",
  "version": "1.0.4",
  "description": "独立的 QQ 陪伴 AI（不依赖 DeepSeek Harness）",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @apps/server dev",
    "build": "pnpm --filter @apps/server build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "desktop:dev": "pnpm --filter @apps/desktop dev",
    "desktop:build": "pnpm --filter @apps/desktop build",
    "desktop:pack": "pnpm --filter @apps/desktop run pack",
    "bench": "pnpm --filter @apps/bench run bench",
    "release": "node scripts/release.mjs",
    "lint:prettier": "prettier --write \"**/*.{js,ts,mjs,cjs,json,tsx,css,less,scss,vue,html,md}\""
  },
  "keywords": [],
  "author": "LumiDesk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LumiDesk/whale-companion.git"
  },
  "homepage": "https://github.com/LumiDesk/whale-companion#readme",
  "bugs": {
    "url": "https://github.com/LumiDesk/whale-companion/issues"
  },
  "license": "AGPL-3.0-only",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
